{
  "expo": {
    "name": "Stage Visualizer",
    "slug": "stage-visualizer",
    "scheme": "stagevis",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stagevis.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "The microphone drives the live stage visualizer.",
        "UIBackgroundModes": []
      }
    },
    "android": {
      "package": "com.stagevis.app",
      "permissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#0a0014",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "iosMicrophonePermission": "The microphone drives the live stage visualizer.",
          "androidPermissions": ["android.permission.RECORD_AUDIO"],
          "androidForegroundService": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
